{
  "name": "@tempsdarret/shared",
  "version": "0.1.0",
  "description": "Shared configurations, types, and utilities for Temps D'arrêt Studio",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "import": "./dist/messaging/index.js",
      "require": "./dist/messaging/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./schemas/shoot.schema": {
      "types": "./dist/schemas/shoot.schema.d.ts",
      "import": "./dist/schemas/shoot.schema.js",
      "require": "./dist/schemas/shoot.schema.js"
    },
    "./schemas/base.schema": {
      "types": "./dist/schemas/base.schema.d.ts",
      "import": "./dist/schemas/base.schema.js",
      "require": "./dist/schemas/base.schema.js"
    },
    "./schemas/user.schema": {
      "types": "./dist/schemas/user.schema.d.ts",
      "import": "./dist/schemas/user.schema.js",
      "require": "./dist/schemas/user.schema.js"
    },
    "./schemas/invite.schema": {
      "types": "./dist/schemas/invite.schema.d.ts",
      "import": "./dist/schemas/invite.schema.js",
      "require": "./dist/schemas/invite.schema.js"
    },
    "./schemas/portfolio.schema": {
      "types": "./dist/schemas/portfolio.schema.d.ts",
      "import": "./dist/schemas/portfolio.schema.js",
      "require": "./dist/schemas/portfolio.schema.js"
    }
  }
}