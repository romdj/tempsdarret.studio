{
  "name": "@tempsdarret/file-service",
  "version": "0.1.0",
  "description": "Large file management, multi-resolution processing, and archive generation service",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:unit": "vitest run tests/services tests/handlers --passWithNoTests",
    "lint": "eslint src",
    "check": "tsc --noEmit",
    "test:component": "vitest run tests/component --passWithNoTests",
    "test:contract": "vitest run tests/contract --passWithNoTests"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@tempsdarret/events": "workspace:*",
    "archiver": "^7.0.1",
    "sharp": "^0.35.4",
    "ts-exif-parser": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "mongodb-memory-server": "^9.5.0",
    "supertest": "^6.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
