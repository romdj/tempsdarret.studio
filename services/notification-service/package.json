{
  "name": "@tempsdarret/notification-service",
  "version": "0.1.0",
  "description": "Event-driven email notifications service with Resend.dev and Payload CMS",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "payload:seed": "tsx src/payload/seed-templates.ts",
    "test": "vitest run --exclude tests/performance/**",
    "test:watch": "vitest --exclude tests/performance/**",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:component": "vitest run tests/component --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:perf": "NODE_OPTIONS=--expose-gc vitest run tests/performance",
    "test:coverage": "vitest run --coverage --exclude tests/performance/**",
    "test:ci": "vitest run --coverage --exclude tests/performance/**",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "tsc --noEmit",
    "test:contract": "vitest run tests/contract --passWithNoTests"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.88.0",
    "@tempsdarret/events": "workspace:*",
    "@tempsdarret/shared": "workspace:*",
    "bullmq": "^5.81.4",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "juice": "^10.0.1",
    "kafkajs": "^2.2.4",
    "payload": "^3.88.0",
    "resend": "^3.5.0"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "mongodb-memory-server": "^9.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
