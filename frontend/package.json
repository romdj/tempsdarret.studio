{
	"name": "@tempsdarret/frontend",
	"private": true,
	"version": "0.1.0",
	"description": "SvelteKit photography portfolio and client portal frontend",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^3.2.7",
		"autoprefixer": "^10.5.5",
		"daisyui": "^4.12.24",
		"eslint": "^9.39.5",
		"postcss": "^8.5.28",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=10.0.0"
	}
}
